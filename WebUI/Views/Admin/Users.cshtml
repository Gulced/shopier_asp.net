@model List<WebApi.Models.Entities.User>

@{
    ViewData["Title"] = "Kullanıcılar";
}

<h2>Kullanıcı Listesi</h2>
<table class="table table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>Ad Soyad</th>
            <th>Email</th>
            <th>Rol</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserId</td>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
            </tr>
        }
    </tbody>
</table>
